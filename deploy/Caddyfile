# Replace quiet.example.com with your domain, or with <server-ip>.sslip.io
# (e.g. 203.0.113.7.sslip.io) if you don't have one. Caddy gets the TLS
# certificate automatically. Only Next.js is exposed; the Go backend stays on
# 127.0.0.1:8080.
quiet.example.com {
	encode gzip
	reverse_proxy 127.0.0.1:3000
}
