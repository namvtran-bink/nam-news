# Copy to /etc/quiet/quiet.env on the server (chmod 600, owned by root:quiet).
# Never commit real values.
TAVILY_API_KEY=
ANTHROPIC_API_KEY=
MODEL=claude-haiku-5-5
# Random, shared by web and backend: openssl rand -hex 32
APP_TOKEN=
APP_PASSWORD=
DB_PATH=/var/lib/quiet/quiet.db
TZ=Asia/Saigon
TRIAL_CAP_PER_DAY=10
BACKEND_URL=http://127.0.0.1:8080
