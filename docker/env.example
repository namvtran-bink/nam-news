# Copy to docker/.env (git-ignored) and fill in. Never commit real values.
TAVILY_API_KEY=
ANTHROPIC_API_KEY=
MODEL=claude-haiku-5-5
TZ=Asia/Saigon
RUN_AT=05:30
# Cloudflare Pages: project name, plus an API token with "Cloudflare Pages: Edit" and your account ID.
CF_PAGES_PROJECT=nam-news
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
