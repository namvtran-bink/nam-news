#!/usr/bin/env bash
# Run the quiet CLI with your Mac settings: mac/quiet add "AI policy", mac/quiet topics, ...
# Loads mac/.env, keeps data in ~/.quiet/, and rebuilds the binary when the code changed.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
QUIET_HOME="$HOME/.quiet"
mkdir -p "$QUIET_HOME"

if [ ! -f "$ROOT/mac/.env" ]; then
  echo "missing $ROOT/mac/.env: copy mac/env.example to mac/.env and fill it in" >&2
  exit 1
fi
set -a; . "$ROOT/mac/.env"; set +a
export DB_PATH="$QUIET_HOME/quiet.db"

BIN="$QUIET_HOME/quiet"
if [ ! -x "$BIN" ] || [ -n "$(find "$ROOT/backend" \( -name '*.go' -o -name '*.html' -o -name '*.sql' -o -name 'go.mod' \) -newer "$BIN" | head -1)" ]; then
  (cd "$ROOT/backend" && go build -o "$BIN" ./cmd/quiet)
fi
exec "$BIN" "$@"
